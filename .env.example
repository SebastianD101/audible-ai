# Copy to .env and fill in. Never commit .env.
# Screenshot reader: auto (Claude when the key and model below are set, else local OCR),
# claude (billed vision model), or ocr (free, local, less accurate; downloads ~31 MB of models
# on first use).
# PARSER=auto
ANTHROPIC_API_KEY=
# Vision model used for screenshot parsing (never hardcoded in code), e.g. claude-opus-5-5.
ANTHROPIC_MODEL=
# Optional: extraction effort (low | medium | high; default medium) and upload cap in bytes
# (default and maximum 5242880, the API's per-image limit).
# ANTHROPIC_EFFORT=medium
# MAX_UPLOAD_BYTES=5242880
# Postgres from `docker compose up db`; leave unset to use a local SQLite file (audible.db).
# Apply migrations with: uv run alembic -c backend/alembic.ini upgrade head
DATABASE_URL=postgresql+psycopg://audible:audible@localhost:5432/audible
# Optional overrides (defaults shown):
# PROJECTIONS_DIR=ml/data/projections
# ROSTERS_DIR=ml/data/raw/rosters_weekly
# CORS_ORIGINS=["http://localhost:3000"]
# SLEEPER_API_URL=https://api.sleeper.app/v1
