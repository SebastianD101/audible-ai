# Copy to .env and fill in. Never commit .env.
# Postgres from `docker compose up db`; leave unset to use a local SQLite file (audible.db).
# Apply migrations with: uv run alembic -c backend/alembic.ini upgrade head
DATABASE_URL=postgresql+psycopg://audible:audible@localhost:5432/audible
# Optional overrides (defaults shown):
# PROJECTIONS_DIR=ml/data/projections
# ROSTERS_DIR=ml/data/raw/rosters_weekly
# CORS_ORIGINS=["http://localhost:3000"]
# SLEEPER_API_URL=https://api.sleeper.app/v1
