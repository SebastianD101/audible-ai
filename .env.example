# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Vision model used for screenshot parsing (never hardcoded in code), e.g. claude-opus-5-5.
ANTHROPIC_MODEL=
# Optional: extraction effort (low | medium | high; default medium) and upload cap in bytes
# (default and maximum 5242880, the API's per-image limit).
# ANTHROPIC_EFFORT=medium
# MAX_UPLOAD_BYTES=5242880
DATABASE_URL=postgresql+psycopg://audible:audible@localhost:5432/audible
